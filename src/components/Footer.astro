---
import { navItems, site } from '../data/site';
import { linkAttrs } from '../utils/links';

const year = new Date().getFullYear();
---

<footer class="footer aw-footer">
  <div class="container">
    <div class="columns is-multiline">
      <div class="column is-5">
        <p class="title is-5 mb-2">{site.name}</p>
        <p>{site.tagline}</p>
      </div>

      <div class="column is-3">
        <p class="has-text-weight-semibold mb-3">Navigare</p>
        <ul>
          {
            navItems.map((item) => (
              <li class="mb-1">
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="column is-4">
        <p class="has-text-weight-semibold mb-3">Urmărește-ne</p>
        <p class="mb-1">
          <a href={site.facebookUrl} {...linkAttrs(site.facebookUrl)}>Facebook · Abstract Cooler</a>
        </p>
        {
          site.email && (
            <p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )
        }
      </div>
    </div>

    <hr />

    <p class="is-size-7">© {year} {site.name}. Toate drepturile rezervate.</p>
  </div>
</footer>
