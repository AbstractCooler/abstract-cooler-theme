---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
  readingTime: string;
  image?: string;
}

const { title, description, pubDate, tags, href, readingTime, image } = Astro.props;
---

<article class:list={['card', 'aw-card', 'aw-card--link', { 'aw-card--media': image }]}>
  {/* Poza articolului (campul "Imagine principala" din /admin). Apare doar daca exista. */}
  {image && <img class="aw-card-media" src={image} alt="" loading="lazy" decoding="async" />}
  <div class="card-content aw-card-content is-flex is-flex-direction-column">
    <p class="aw-blog-meta mb-2">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {' · '}
      {readingTime}
    </p>
    <h2 class="title is-4">
      <a class="aw-card-link" href={href}>{title}</a>
    </h2>
    <p class="mb-4">{description}</p>
    <div class="mb-4">
      {tags.map((tag) => <span class="aw-tag">#{tag}</span>)}
    </div>
    <p class="aw-card-format">Citește articolul →</p>
  </div>
</article>
