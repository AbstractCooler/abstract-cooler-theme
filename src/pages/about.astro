---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { team, values } from '../data/team';
import about from '../data/content/about.json';
---

<BaseLayout title={about.pageTitle} description={about.pageDescription}>
  <PageHero
    eyebrow={about.heroEyebrow}
    title={about.heroTitle}
    subtitle={about.heroSubtitle}
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <h2 class="title is-2 mb-4">{about.whyTitle}</h2>
          <div class="content">
            {about.whyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="column is-5">
          <div class="box aw-hero-box">
            <p class="aw-eyebrow mb-3">{about.shortTitle}</p>
            <ul class="content">
              {about.shortItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">{about.valuesEyebrow}</p>
        <h2 class="title is-2">{about.valuesTitle}</h2>
      </div>

      <div class="columns">
        {
          values.map((value, index) => (
            <div class="column is-4">
              <div class="box aw-card">
                <p class="aw-value-number mb-2">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="title is-5">{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">{about.teamEyebrow}</p>
        <h2 class="title is-2">{about.teamTitle}</h2>
        <p class="subtitle is-6">{about.teamSubtitle}</p>
      </div>

      <div class="columns">
        {
          team.map((member) => (
            <div class="column is-3">
              <div class="box aw-card">
                <div class="is-flex is-align-items-center mb-4">
                  <span class="aw-avatar mr-4" aria-hidden="true">{member.initials}</span>
                  <div>
                    <h3 class="title is-5 mb-1">{member.name}</h3>
                    <p class="aw-form-note">{member.role}</p>
                  </div>
                </div>
                <p>{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand eyebrow={about.ctaEyebrow} title={about.ctaTitle} text={about.ctaText} />
</BaseLayout>
