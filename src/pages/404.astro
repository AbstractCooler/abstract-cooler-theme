---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina nu a fost găsită"
  description="Pagina pe care o cauți nu există sau a fost mutată. Întoarce-te acasă pentru a continua."
>
  <PageHero
    eyebrow="Eroare 404"
    title="Pagina nu a fost găsită."
    subtitle="Pagina pe care o cauți a fost mutată, redenumită sau nu a existat niciodată. Hai înapoi la lucrurile bune."
    compact
  >
    <div class="buttons is-centered mt-5">
      <a class="button is-primary is-medium" href="/">Înapoi acasă</a>
      <a class="button is-medium is-outlined" href="/blog">Citește blogul</a>
    </div>
  </PageHero>
</BaseLayout>
