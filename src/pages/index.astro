---
// ============================================================================
// PAGINA PRINCIPALA (acasa) - fisierul acesta construieste https://.../
//
// Cum e organizat:
//  - Partea dintre cele doua linii "---" (aici) = importuri si date. Nu o atinge
//    daca nu stii ce faci.
//  - Partea de dupa (cu <BaseLayout>) = ce se vede pe pagina, de sus in jos.
//  - Textele NU sunt scrise aici, ci in fisierul src/data/content/home.json.
//    Le editezi din panoul /admin → "Pagini" → "Pagina principala".
//  - Comentariile de forma {/* ... */} nu apar pe site, sunt doar pentru tine.
// ============================================================================
import CtaBand from '../components/CtaBand.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import BlogCard from '../components/BlogCard.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import home from '../data/content/home.json';
import { linkAttrs } from '../utils/links';
import { getCollection } from 'astro:content';

// Date structurate pentru Google (nu se vad pe pagina): descriu site-ul
// si il leaga de pagina de Facebook.
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: site.url,
  inLanguage: 'ro',
  sameAs: [site.facebookUrl, site.instagramUrl].filter(Boolean),
};

// Cardurile din sectiunea "Ce gasesti la noi" sunt primele 3 categorii din
// /admin → Pagini → Categorii. Schimba 3 cu alt numar ca sa arati mai multe/putine.
const featuredServices = services.slice(0, 3);

// Preluăm primele 15 articole de pe blog în mod sigur (filtrând intrările fără dată)
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter((post) => post.data && post.data.date)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 15);
---

<BaseLayout title={site.name} description={site.description} schema={siteSchema}>
  {/*
    ==========================================================================
    SECTIUNEA 1 - HERO (zona mare de sus, prima care se vede)
    Stanga: text mic, titlu mare, subtitlu si doua butoane.
    Dreapta: caseta cu logo (mai jos, in "aside").
    Texte: /admin → Pagini → Pagina principala → campurile "Hero ...",
    "Buton principal ...", "Buton secundar ...".
    ==========================================================================
  */}
  <PageHero eyebrow={home.heroEyebrow} title={home.heroTitle} subtitle={home.heroSubtitle}>
    {/* Butoanele de sub subtitlu: primul (rosu) duce la Facebook, al doilea (contur) la blog, al treilea la Instagram. */}
    <div class="buttons mt-5">
      <a
        class="button is-primary is-medium"
        href={home.primaryButtonLink}
        {...linkAttrs(home.primaryButtonLink)}
      >
        {home.primaryButtonLabel}
      </a>
      <a
        class="button is-medium is-outlined"
        href={home.secondaryButtonLink}
        {...linkAttrs(home.secondaryButtonLink)}
      >
        {home.secondaryButtonLabel}
      </a>
      {/* Butonul Instagram apare doar daca ai pus linkul in /admin > Setari site. */}
      {
        site.instagramUrl && (
          <a
            class="button is-medium is-outlined"
            href={site.instagramUrl}
            {...linkAttrs(site.instagramUrl)}
          >
            <InstagramIcon class="mr-2" />
            Instagram
          </a>
        )
      }
    </div>

    {/*
      Caseta din DREAPTA hero-ului: logo-ul (fisierul public/logo.png), o
      propozitie scurta si butonul catre Facebook.
      Texte: campurile "Caseta cu logo ...". Ca sa schimbi logo-ul, inlocuieste
      fisierul public/logo.png.
    */}
    <Fragment slot="aside">
      <div class="box aw-hero-box has-text-centered">
        <img
          class="aw-hero-logo"
          src="/logo.png"
          width="1000"
          height="418"
          alt={`${site.name} - ${site.tagline}`}
        />
        <p class="aw-form-note mt-4 mb-3">{home.asideNote}</p>
        <a
          class="button is-primary is-outlined"
          href={site.facebookUrl}
          {...linkAttrs(site.facebookUrl)}
        >
          {home.asideLinkLabel}
        </a>
      </div>
    </Fragment>
  </PageHero>

  {/*
    ==========================================================================
    SECTIUNEA 2 - "CE GASESTI LA NOI" (fundal usor diferit, 3 carduri)
    Titlu + subtitlu, apoi 3 carduri cu categorii (Gaming, Tech, Cinema) si
    butonul "Vezi toate categoriile".
    Texte titlu/buton: campurile "Categorii - ..." din Pagina principala.
    Textul din carduri: /admin → Pagini → Categorii.
    Ca sa o stergi: sterge de la acest comentariu pana la inchiderea sectiunii (inainte de urmatorul comentariu SECTIUNEA).
    ==========================================================================
  */}
  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">{home.servicesEyebrow}</p>
        <h2 class="title is-2">{home.servicesTitle}</h2>
        <p class="subtitle is-6">{home.servicesSubtitle}</p>
      </div>

      {/* Cele 3 carduri cu categorii. */}
      <div class="columns">
        {
          featuredServices.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>

      {/* Butonul de sub carduri, duce la pagina Categorii. */}
      <div class="has-text-centered mt-6">
        <a class="button is-medium is-outlined" href="/services">{home.servicesButtonLabel}</a>
      </div>
    </div>
  </section>

  {/*
    ==========================================================================
    SECTIUNEA 3 - ULTIMELE ARTICOLE (primele 15 articole de pe blog, afișate sub formă de grilă)
    Se încarcă automat cele mai noi 15 articole din colecția de blog.
    ==========================================================================
  */}
  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head mb-6">
        <h2 class="title is-2">Ultimele Articole</h2>
        <p class="subtitle is-6">Descoperă cele mai recente noutăți și articole publicate.</p>
      </div>

      <div class="columns is-multiline">
        {
          latestPosts.map((post) => (
            <div class="column is-4">
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    ==========================================================================
    SECTIUNEA 4 - CITATUL (o propozitie mare, cu bara rosie in stanga)
    Stanga: citatul si semnatura. Dreapta: buton rosu spre Facebook + o nota.
    Texte: campurile "Citat ..." din Pagina principala.
    Ca sa o stergi: sterge de la acest comentariu pana la inchiderea sectiunii (inainte de urmatorul comentariu SECTIUNEA).
    ==========================================================================
  */}
  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <p class="aw-quote mb-4">“{home.quote}”</p>
          <p class="has-text-weight-semibold">{home.quoteAuthor}</p>
        </div>
        <div class="column is-5 has-text-centered">
          <a
            class="button is-primary is-medium"
            href={site.facebookUrl}
            {...linkAttrs(site.facebookUrl)}
          >
            {home.quoteButtonLabel}
          </a>
          <p class="aw-form-note mt-3">{home.quoteButtonNote}</p>
        </div>
      </div>
    </div>
  </section>

  {/*
    ==========================================================================
    SECTIUNEA 5 - "DE CE ABSTRACT COOLER" (fundal usor diferit, 3 casete numerotate)
    Titlu + subtitlu, apoi trei casete: 01, 02, 03, fiecare cu titlu si text.
    Texte: campurile "De ce noi - ..." din Pagina principala (casetele sunt
    in lista "De ce noi - casete": poti adauga sau sterge casete de acolo).
    Ca sa o stergi: sterge de la acest comentariu pana la inchiderea sectiunii (inainte de urmatorul comentariu SECTIUNEA).
    ==========================================================================
  */}
  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">{home.whyEyebrow}</p>
        <h2 class="title is-2">{home.whyTitle}</h2>
        <p class="subtitle is-6">{home.whySubtitle}</p>
      </div>

      <div class="columns">
        {
          home.whyCards.map((card, index) => (
            <div class="column is-4">
              <div class="box aw-card">
                <p class="aw-value-number mb-2">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="title is-5">{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    ==========================================================================
    SECTIUNEA 6 - BANDA FINALA (caseta mare de jos, cu buton spre Facebook)
    Ultima sectiune dinaintea footer-ului (partea de jos a site-ului).
    Texte: campurile "Banda finala - ..." din Pagina principala.
    Componenta: src/components/CtaBand.astro
    ==========================================================================
  */}
  <CtaBand
    eyebrow={home.ctaEyebrow}
    title={home.ctaTitle}
    text={home.ctaText}
    ctaLabel={home.ctaLabel}
  />
</BaseLayout>
