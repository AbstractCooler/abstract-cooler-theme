---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---
<Layout title="Abstract Cooler">
  <NavBar />
  <main class="flex flex-col items-center justify-center min-h-screen px-4">
    <section class="text-center max-w-3xl py-20">
      <h1 class="text-5xl font-extrabold tracking-tight mb-6">
        Welcome to <span class="text-rose-600">Abstract Cooler</span>
      </h1>
      <p class="text-xl text-slate-400 mb-8">
        Than your average content. Modern, sleek, and powered by a striking red aesthetic.
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/services" class="btn-primary px-6 py-3 rounded-lg font-semibold shadow-lg">Explore Services</a>
        <a href="/contact" class="border border-slate-700 px-6 py-3 rounded-lg font-semibold hover:bg-slate-800 transition">Get in Touch</a>
      </div>
    </section>
  </main>
</Layout>
