---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/content/services.json';
---

<BaseLayout title={page.pageTitle} description={page.pageDescription}>
  <PageHero
    eyebrow={page.heroEyebrow}
    title={page.heroTitle}
    subtitle={page.heroSubtitle}
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">{page.sectionEyebrow}</p>
        <h2 class="title is-2">{page.sectionTitle}</h2>
      </div>

      <div class="columns is-multiline">
        {
          page.items.map((item) => (
            <div class="column is-4">
              <ServiceCard {...item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={page.ctaEyebrow}
    title={page.ctaTitle}
    text={page.ctaText}
    ctaLabel={page.ctaLabel}
  />
</BaseLayout>
