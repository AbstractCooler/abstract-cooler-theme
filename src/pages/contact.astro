---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import contact from '../data/content/contact.json';
import { linkAttrs } from '../utils/links';
---

<BaseLayout title={contact.pageTitle} description={contact.pageDescription}>
  <PageHero
    eyebrow={contact.heroEyebrow}
    title={contact.heroTitle}
    subtitle={contact.heroSubtitle}
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns">
        <div class="column is-5">
          <h2 class="title is-4">{contact.findTitle}</h2>
          <div class="aw-contact-list">
            <div>
              <p class="aw-contact-label mb-1">{contact.facebookLabel}</p>
              <p class="mb-3">{contact.facebookText}</p>
              <a
                class="button is-primary"
                href={site.facebookUrl}
                {...linkAttrs(site.facebookUrl)}
              >
                {contact.facebookButton}
              </a>
            </div>
            {
              site.email && (
                <div>
                  <p class="aw-contact-label mb-1">{contact.emailLabel}</p>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </div>
              )
            }
          </div>
        </div>

        <div class="column is-6 is-offset-1">
          <div class="box aw-card">
            <h2 class="title is-4">{contact.ideaTitle}</h2>
            <p class="mb-4">{contact.ideaText}</p>
            <a
              class="button is-outlined"
              href={site.facebookUrl}
              {...linkAttrs(site.facebookUrl)}
            >
              {contact.facebookButton}
            </a>
          </div>

          <div class="aw-notice mt-5">{contact.noticeText}</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
